(* The live list of messages of a feed, with delete and delete all. The feed
   shows its first pages, as many as the URL says (?pages=N). While there are
   older messages, the list ends with a link to the URL with one more page,
   which also works without JavaScript; with it, the island follows the link
   when it comes into view, keeping the scroll and the history entry, so a
   reload or Back shows every page that was loaded. *)

(* Material's delete icon. Plain ASCII: a non-ASCII OCaml literal is UTF-8
   bytes, which Melange would show byte by byte in the browser. *)
let trash =
  Yuka.element "svg"
    [ Yuka.attr "viewBox" "0 0 24 24"; Yuka.attr "width" "24"; Yuka.attr "height" "24"; Yuka.attr "aria-hidden" "true" ]
    [
      Yuka.element "path"
        [ Yuka.attr "fill" "currentColor"; Yuka.attr "d" "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" ]
        [];
    ]

let undo_ms = 5000
let body_id id = "message-body-" ^ Int.to_string id

let[@client] make ~(feed : Model.feed) ~(initial : Model.page) ~(title : string) ~(image : string) () =
  let live = Yuka.Live.make Topics.messages (fun () -> feed) in
  let page () =
    Option.value (Yuka.Status.data (Yuka.State.get (Yuka.Live.state live))) ~default:initial
  in
  (* Deleted messages wait [undo_ms] for an Undo before the server deletes
     them: hidden at once, deleted when their timer ends or when the list goes
     away, such as on a navigation to another page. *)
  let pending = Yuka.State.make [] in
  let timers : (int, unit -> unit) Hashtbl.t = Hashtbl.create 4 in
  let messages () =
    let hidden = Yuka.State.get pending in
    List.filter (fun (m : Model.message) -> not (List.mem m.id hidden)) (page ()).messages
  in
  (* The socket closed: Yuka reconnects by itself, with delays of up to 5 s,
     and gives up on a refused key. Retry loads the page again from the
     server, which also gives a new subscription, once the server answers:
     a client navigation that fails becomes a full page load, which would
     show the browser's error page. *)
  let disconnected () =
    match Yuka.State.get (Yuka.Live.state live) with
    | Yuka.Status.Ready { stale; _ } -> stale
    | Failed _ -> true
    | Idle | Loading _ -> false
  in
  let unreachable = Yuka.State.make false in
  Yuka.Effect.after (fun () -> if not (disconnected ()) then Yuka.State.set unreachable false);
  let retry _ =
    Yuka.Async.on_result (Yuka.Action.call Actions.ping ()) (function
      | Ok (Ok ()) ->
          Yuka.State.set unreachable false;
          Yuka.Browser.refresh ()
      | Ok (Error _) | Error _ -> Yuka.State.set unreachable true)
  in
  let next =
    let pages = feed.pages + 1 in
    match feed.app with None -> Routes.messages ~pages () | Some app -> Routes.app_messages ~app ~pages ()
  in
  Yuka.Effect.after ~cleanup:(fun stop -> stop ()) (fun () ->
      if (page ()).more then
        Yuka.Browser.on_visible "next-page" (fun () -> Yuka.Browser.navigate ~replace:true ~keep_scroll:true next)
      else fun () -> ());
  (* The time the relative dates count from, moved on every 30 s. *)
  let clock = Yuka.State.make (!Platform.now ()) in
  Yuka.Effect.after ~cleanup:(fun stop -> stop ()) (fun () ->
      !Platform.every 30_000 (fun () -> Yuka.State.set clock (!Platform.now ())));
  (* Read more: once the island runs, a long body is cut at the height of
     .message-body.collapsed, with a button to show it all. Without
     JavaScript every body shows in full. [overflowing]: the ids whose body
     is cut, measured after each change of the list and on a resize. *)
  let started = Yuka.State.make false in
  let expanded = Yuka.State.make [] in
  let overflowing = Yuka.State.make [] in
  let measure () =
    let open_ = Yuka.State.peek expanded in
    Yuka.State.set overflowing
      (List.filter_map
         (fun (m : Model.message) ->
           if List.mem m.id open_ || !Platform.overflows (body_id m.id) then Some m.id else None)
         (messages ()))
  in
  Yuka.Effect.after (fun () -> Yuka.State.set started true);
  Yuka.Effect.after (fun () -> if Yuka.State.get started then measure ());
  Yuka.Effect.after (fun () -> Yuka.Browser.on_window "resize" (fun _ -> measure ()));
  let toggle id _ =
    Yuka.State.update expanded (fun ids -> if List.mem id ids then List.filter (( <> ) id) ids else id :: ids)
  in
  let failure = Yuka.State.make None in
  let report = function
    | Ok (Ok ()) -> Yuka.State.set failure None
    | Ok (Error e) -> Yuka.State.set failure (Some (Yuka.Status.error_to_string e))
    | Error m -> Yuka.State.set failure (Some m)
  in
  let commit (id : int) =
    Hashtbl.remove timers id;
    Yuka.Async.on_result
      (Yuka.Live.optimistic live
         ~change:(fun (p : Model.page) ->
           { p with messages = List.filter (fun (m : Model.message) -> m.id <> id) p.messages })
         (fun () -> Yuka.Action.call Actions.delete_message id))
      report;
    Yuka.State.update pending (List.filter (( <> ) id))
  in
  let delete (id : int) _ =
    Yuka.State.update pending (fun ids -> id :: ids);
    Hashtbl.replace timers id (!Platform.after undo_ms (fun () -> commit id))
  in
  let undo _ =
    Hashtbl.iter (fun _ cancel -> cancel ()) timers;
    Hashtbl.reset timers;
    Yuka.State.set pending []
  in
  (* The list goes away: delete the waiting messages now. *)
  Yuka.Effect.after
    ~cleanup:(fun () ->
      Hashtbl.iter
        (fun id cancel ->
          cancel ();
          Yuka.Async.on_result (Yuka.Action.call Actions.delete_message id) ignore)
        timers;
      Hashtbl.reset timers)
    (fun () -> ());
  let delete_all _ =
    if Yuka.Browser.confirm "Delete all messages?" then
      Yuka.Async.on_result
        (Yuka.Live.optimistic live ~change:(fun _ -> { Model.messages = []; more = false }) (fun () -> Yuka.Action.call Actions.delete_all feed.app))
        report
  in
  <section class_="messages">
    <header class_="page-header">
      <h1>(Yuka.text title)</h1>
      <div class_="row">
        (match feed.app with
         | Some app -> <a class_="button contained" href=(Routes.app_push ~app ())>"Push message"</a>
         | None -> Yuka.empty)
        <button type_=`button class_="button outlined" disabled=(messages () = []) on_click=delete_all>
          "Delete all"
        </button>
      </div>
    </header>
    <div class_="card banner" role=`status hidden=(not (disconnected ()))>
      <span>
        (Yuka.text
           (if Yuka.State.get unreachable then "The server is still unreachable. Trying again..."
            else "Lost the connection to the server. New messages show again once it is back."))
      </span>
      <button type_=`button class_="button text" on_click=retry>"Retry"</button>
    </div>
    <div class_="snackbar" role=`status hidden=(Yuka.State.get pending = [])>
      <span>
        (Yuka.text
           (match List.length (Yuka.State.get pending) with
            | 1 -> "Message deleted"
            | n -> Int.to_string n ^ " messages deleted"))
      </span>
      <button type_=`button class_="button text" on_click=undo>"Undo"</button>
    </div>
    <p class_="error" role=`alert hidden=(Yuka.State.get failure = None)>
      (Yuka.text (Option.value (Yuka.State.get failure) ~default:""))
    </p>
    <p class_="empty" hidden=(messages () <> [])>"No messages"</p>
    <ol class_="message-list">
      (Yuka.each ~equal:( = )
         ~key:(fun (m : Model.message) -> Int.to_string m.id)
         (fun () -> Array.of_list (messages ()))
         (fun (m : Model.message) ->
           <li class_="card message" data_priority=(Int.to_string m.priority)>
             <img class_="app-image" src=image alt="" width="70" height="70" />
             <div class_="message-main">
               <div class_="message-head">
                 <div class_="message-heading">
                   <h2 class_="message-title">(Yuka.text m.title)</h2>
                   <span class_="message-app">(Yuka.text m.app_name)</span>
                 </div>
                 <time class_="message-date" title=m.date>(Yuka.text (Time_ago.text ~now:(Yuka.State.get clock) m.time))</time>
                 <button type_=`button class_="icon-button" aria_label="Delete message" title="Delete"
                   on_click=(delete m.id)>
                   trash
                 </button>
               </div>
               <div id=(body_id m.id)
                 class_=(String.concat " "
                           [
                             "message-body";
                             (if m.markdown then "markdown" else "plain");
                             (if Yuka.State.get started && not (List.mem m.id (Yuka.State.get expanded)) then
                                if List.mem m.id (Yuka.State.get overflowing) then "collapsed clipped" else "collapsed"
                              else "");
                           ])>
                 (Yuka.fragment (List.map Markup.view m.body))
               </div>
               <button type_=`button class_="button text read-more" hidden=(not (List.mem m.id (Yuka.State.get overflowing)))
                 aria_expanded=(List.mem m.id (Yuka.State.get expanded)) aria_controls=(body_id m.id) on_click=(toggle m.id)>
                 (Yuka.text (if List.mem m.id (Yuka.State.get expanded) then "Read less" else "Read more"))
               </button>
             </div>
           </li>))
    </ol>
    <a id="next-page" class_="button outlined load-more" href=next data_yuka_replace="" data_yuka_keep_scroll=""
      hidden=(not (page ()).more)>
      (Yuka.text (if Yuka.State.get Yuka.Browser.navigating then "Loading..." else "Load more"))
    </a>
  </section>
