(* The Change password form of the Settings page. [user]: as Confirm_form. *)

let[@client] make ~(user : string option) () =
  <Yuka.Form action=Actions.password>
    (fun form ->
      <div class_="stack-plain">
        <label class_="field">"New password"
          <input type_=`password name="pass" required=true autocomplete="new-password" />
          (Dialog_form.error form `Pass)
        </label>
        (Dialog_form.password form ~user)
        (Dialog_form.errors form)
        <div class_="dialog-actions">(Dialog_form.submit form "Change password")</div>
      </div>)
  </Yuka.Form>
