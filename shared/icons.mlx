(* Material icons as inline SVG, and the icon links of the table rows, as
   Gotify's web UI has them: the label is the link's accessible name and its
   tooltip. *)

let svg ?(size = 20) d =
  let size = Int.to_string size in
  Yuka.element "svg"
    [ Yuka.attr "viewBox" "0 0 24 24"; Yuka.attr "width" size; Yuka.attr "height" size; Yuka.attr "aria-hidden" "true" ]
    [ Yuka.element "path" [ Yuka.attr "fill" "currentColor"; Yuka.attr "d" d ] [] ]

