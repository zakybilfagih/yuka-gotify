(* The Create user form of the Users page. [user]: as Confirm_form. *)

let[@client] make ~(user : string option) () =
  <Yuka.Form action=Actions.user_create>
    (fun form ->
      <div class_="stack-plain">
        <label class_="field">"Name"
          <input name="name" value=(Dialog_form.sent form `Name "") required=true autocomplete="off" />
          (Dialog_form.error form `Name)
        </label>
        <label class_="field">"Password"
          <input type_=`password name="pass" required=true autocomplete="new-password" />
          (Dialog_form.error form `Pass)
        </label>
        <label class_="check"><input type_=`checkbox name="admin" />"Has administrator rights"</label>
        (Dialog_form.password form ~user)
        (Dialog_form.errors form)
        <div class_="dialog-actions">(Dialog_form.submit form "Create")</div>
      </div>)
  </Yuka.Form>
