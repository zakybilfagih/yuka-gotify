open App_shared
module M = Gotify_core.Model

let version = Gotify_core.Api.version
(* The release of Gotify that the API follows: the version without "-yuka". *)
let release =
  "https://github.com/gotify/server/releases/tag/v" ^ List.hd (String.split_on_char '-' version)

let theme_class theme = "app theme-" ^ theme

let alert_view = function
  | None -> Yuka.empty
  | Some message -> <p class_="alert" role=`alert>(Yuka.text message)</p>

(* The user name of a session that must give its password in a dialog form. *)
let password_user (session : Ui.session) = if Ui.elevated session then None else Some session.user.name

let link_button ?(class_ = "button text") href label = <a class_ href>(Yuka.text label)</a>

(* For an action that Gotify allows only to an elevated session: the
   password, which the handler checks before it acts (Ui.posted_elevated). *)
let elevation_field (session : Ui.session) =
  if Ui.elevated session then Yuka.empty
  else
    <label class_="field">(Yuka.text ("Password of " ^ session.user.name ^ ", for a recent sign-in"))
      <input type_=`password name="elevate_pass" required=true autocomplete="current-password" />
    </label>

let shell ~(session : Ui.session) ~children () =
  let link href label = <a class_="appbar-link" href>(Yuka.text label)</a> in
  let next_theme = if session.theme = "dark" then "light" else "dark" in
  <div class_=(theme_class session.theme)>
    <Yuka.Client start=`Idle><Nav_progress /></Yuka.Client>
    <header class_="appbar">
      <a class_="brand" href=(Routes.messages ())>"Gotify"</a>
      <a class_="brand-version" href=release title="Release notes of this Gotify version">(Yuka.text ("@" ^ version))</a>
      <nav class_="appbar-actions" aria_label="Main">
        <form method_=`post action=(Routes.theme ()) class_="inline-form">
          <input type_=`hidden name="theme" value=next_theme />
          <input type_=`hidden name="next" value="/" />
          <button type_=`submit class_="appbar-link" title="Toggle theme">
            (Yuka.text (if next_theme = "dark" then "Dark" else "Light"))
          </button>
        </form>
        (link (Routes.applications ()) "Apps")
        (link (Routes.clients ()) "Clients")
        (if session.user.admin then link (Routes.users ()) "Users" else Yuka.empty)
        (link (Routes.settings ()) "Settings")
        <form method_=`post action=(Routes.logout ()) class_="inline-form">
          <button type_=`submit class_="appbar-link">"Logout"</button>
        </form>
      </nav>
    </header>
    <div class_="layout">
      <Yuka.Client>
        <Drawer apps=(List.map (fun (a : M.application) -> { Model.id = a.id; name = a.name }) session.apps)
          image=(Static.url "defaultapp.png")>
          <Yuka.Client><Notifications user=session.user.id icon=(Static.url "defaultapp.png") /></Yuka.Client>
        </Drawer>
      </Yuka.Client>
      <main class_="content">children</main>
    </div>
  </div>

(* The page waits for the messages and gives them to the island: in a server
   render, Yuka.Live.make has the state only when it is already loaded, so a
   new key, such as one more page, would render an empty list, which the page
   without JavaScript keeps and the page with it shows until the state comes. *)
let message_list feed ~title =
  <Yuka.Await async=(Yuka_server.to_async (Feed.load feed)) blocking=`Yes loading=Yuka.empty>
    (fun initial -> <Yuka.Client><Message_list feed title initial image=(Static.url "defaultapp.png") /></Yuka.Client>)
  </Yuka.Await>

let messages ~(session : Ui.session) ~pages ~alert () =
  Yuka.Server.page ~title:"Gotify" (fun () ->
      let feed = { Model.user = session.user.id; app = None; pages } in
      Yuka.fragment [ alert_view alert; message_list feed ~title:"All Messages" ])

let app_messages ~(session : Ui.session) ~app ~pages ~alert () =
  let title =
    match List.find_opt (fun (a : M.application) -> a.id = app) session.apps with
    | Some a -> a.name
    | None -> "Unknown application"
  in
  Yuka.Server.page ~title:(title ^ " - Gotify") (fun () ->
      let feed = { Model.user = session.user.id; app = Some app; pages } in
      Yuka.fragment [ alert_view alert; message_list feed ~title ])

let token_reveal ~kind = function
  | None -> Yuka.empty
  | Some (name, token) ->
      <section class_="card reveal" role=`status>
        <h2>(Yuka.text (kind ^ " token for " ^ name))</h2>
        <p>"Copy it now: Gotify shows a token only once."</p>
        <div class_="row">
          <input class_="token" readonly=true value=token aria_label="Token" />
          <Yuka.Client><Copy_button value=token /></Yuka.Client>
        </div>
      </section>

let priority_input value =
  <label class_="field">"Default priority"
    <input type_=`number name="defaultPriority" min="0" max="10" value=(Int.to_string value) />
  </label>

let applications ~(session : Ui.session) ~reveal ~alert () =
  Yuka.Server.page ~title:"Applications - Gotify" (fun () ->
      <section>
        <header class_="page-header">
          <h1>"Applications"</h1>
        </header>
        (alert_view alert)
        (token_reveal ~kind:"Application" (Ui.revealed session reveal))
        <details class_="create">
          <summary class_="button contained">"Create application"</summary>
          <form method_=`post action=(Routes.app_create ()) class_="stack">
            <label class_="field">"Name" <input name="name" required=true autocomplete="off" /></label>
            <label class_="field">"Short description" <input name="description" autocomplete="off" /></label>
            (priority_input 0)
            <button type_=`submit class_="button contained">"Create"</button>
          </form>
        </details>
        <div class_="card table-card">
          <Yuka.Client>
            <App_table image=(Static.url "defaultapp.png")
              apps=(List.map
                      (fun (a : M.application) ->
                        { Model.id = a.id; name = a.name; description = a.description; priority = a.default_priority;
                          last_used = Ui.date_opt a.last_used; created = Ui.date a.created_at })
                      session.apps) />
          </Yuka.Client>
          (if session.apps = [] then <p class_="empty">"No applications"</p> else Yuka.empty)
        </div>
      </section>)

let clients ~(session : Ui.session) ~(clients : M.client list) ~reveal ~alert () =
  Yuka.Server.page ~title:"Clients - Gotify" (fun () ->
      let now = Unix.gettimeofday () in
      <section>
        <header class_="page-header"><h1>"Clients"</h1></header>
        (alert_view alert)
        (token_reveal ~kind:"Client" (Ui.revealed session reveal))
        <details class_="create">
          <summary class_="button contained">"Create client"</summary>
          <form method_=`post action=(Routes.client_create ()) class_="stack">
            <label class_="field">"Name" <input name="name" required=true autocomplete="off" /></label>
            <label class_="field">"Expire after inactivity (seconds, 0 = never)"
              <input type_=`number name="expiresAfterInactivitySeconds" min="0" value="0" />
            </label>
            <button type_=`submit class_="button contained">"Create"</button>
          </form>
        </details>
        <div class_="card table-card">
          <table>
            <thead><tr><th>"Name"</th><th>"Last used"</th><th>"Created"</th><th>"Expires"</th><th>"Elevation ends"</th><th /></tr></thead>
            <tbody>
              (Yuka.fragment
                 (List.map
                    (fun (c : M.client) ->
                      <tr>
                        <td>
                          (Yuka.text c.name)
                          (if c.id = session.client.id then <span class_="chip">"this browser"</span> else Yuka.empty)
                        </td>
                        <td><time>(Yuka.text (Ui.date_opt c.last_used))</time></td>
                        <td><time>(Yuka.text (Ui.date c.created_at))</time></td>
                        <td>
                          (match M.expires_at c with
                           | Some t -> <Yuka.Client><Countdown until=t ended="expired" title=(Ui.date t) /></Yuka.Client>
                           | None -> Yuka.text "never")
                        </td>
                        <td>
                          (match c.elevated_until with
                           | Some t when M.elevated ~now c ->
                               <Yuka.Client><Countdown until=t ended="no" title=(Ui.date t) /></Yuka.Client>
                           | _ -> Yuka.text "no")
                        </td>
                        <td class_="actions">
                          (link_button (Routes.client_elevate ~id:c.id ()) "Elevate")
                          (link_button (Routes.client_edit ~id:c.id ()) "Edit")
                          (link_button ~class_:"button text danger" (Routes.client_remove ~id:c.id ()) "Delete")
                        </td>
                      </tr>)
                    clients))
            </tbody>
          </table>
        </div>
      </section>)

let users ~(session : Ui.session) ~(users : M.user list) ~alert () =
  Yuka.Server.page ~title:"Users - Gotify" (fun () ->
      if not session.user.admin then <section><h1>"Users"</h1><p class_="alert">"Admins only."</p></section>
      else
        <section>
          <header class_="page-header"><h1>"Users"</h1></header>
          (alert_view alert)
          <details class_="create">
            <summary class_="button contained">"Create user"</summary>
            <form method_=`post action=(Routes.user_create ()) class_="stack">
              <label class_="field">"Name" <input name="name" required=true autocomplete="off" /></label>
              <label class_="field">"Password" <input type_=`password name="pass" required=true autocomplete="new-password" /></label>
              <label class_="check"><input type_=`checkbox name="admin" />"Has administrator rights"</label>
              (elevation_field session)
              <button type_=`submit class_="button contained">"Create"</button>
            </form>
          </details>
          <div class_="card table-card">
            <table>
              <thead><tr><th>"Name"</th><th>"Admin"</th><th>"Created"</th><th /></tr></thead>
              <tbody>
                (Yuka.fragment
                   (List.map
                      (fun (u : M.user) ->
                        <tr>
                          <td>(Yuka.text u.name)</td>
                          <td>(Yuka.text (if u.admin then "Yes" else "No"))</td>
                          <td><time>(Yuka.text (Ui.date u.created_at))</time></td>
                          <td class_="actions">
                            (link_button (Routes.user_edit ~id:u.id ()) "Edit")
                            (link_button ~class_:"button text danger" (Routes.user_remove ~id:u.id ()) "Delete")
                          </td>
                        </tr>)
                      users))
              </tbody>
            </table>
          </div>
        </section>)

(* Dialogs. Each route of Routes.ml has one view, shown two ways: as an
   overlay over its list after a click (client navigation), or as a page of
   its own on a direct load, a reload or without JavaScript. A view is its
   title, the list it closes to and its body, which gets the Cancel to place. *)

type frame = Page | Overlay

let dialog frame ~(session : Ui.session) ~alert (title, back, body) =
  Yuka.Server.page ~title:(title ^ " - Gotify") (fun () ->
      let card cancel =
        <div class_="card dialog" role=`dialog aria_modal=true aria_labelledby="overlay-title">
          <h2 id="overlay-title">(Yuka.text title)</h2>
          (alert_view alert)
          (body cancel)
        </div>
      in
      match frame with
      | Page -> <section class_="narrow dialog-page">(card (link_button back "Cancel"))</section>
      | Overlay ->
          <div class_=(theme_class session.theme ^ " overlay")>
            <Yuka.Client><Overlay_close backdrop=true /></Yuka.Client>
            (card <Yuka.Client><Overlay_close backdrop=false /></Yuka.Client>)
          </div>)

let submit ?(class_ = "button contained") label = <button type_=`submit class_>(Yuka.text label)</button>

(* The actions row: the Cancel, then the submit button. *)
let with_submit cancel button = <div class_="dialog-actions">cancel button</div>

let missing back =
  ("Not found", back, fun cancel -> Yuka.fragment [ <p>"It does not exist anymore."</p>; <div class_="dialog-actions">cancel</div> ])

let find_app (session : Ui.session) id = List.find_opt (fun (a : M.application) -> a.id = id) session.apps

let app_edit_view ~session ~id =
  match find_app session id with
  | None -> missing "/applications"
  | Some a ->
      ( "Edit " ^ a.name,
        "/applications",
        fun actions ->
          <form method_=`post action=(Routes.app_update ~id ())>
            <label class_="field">"Name" <input name="name" value=a.name required=true autofocus=true /></label>
            <label class_="field">"Short description" <input name="description" value=a.description /></label>
            (priority_input a.default_priority)
            (with_submit actions (submit "Save"))
          </form> )

let app_remove_view ~(session : Ui.session) ~id =
  match find_app session id with
  | None -> missing "/applications"
  | Some a ->
      ( "Delete " ^ a.name,
        "/applications",
        fun actions ->
          <Yuka.Client>
            <Confirm_form target=(Actions.Target.to_string (App_delete id)) text="The application and all its messages are deleted." button="Delete" danger=true user=(password_user session)>actions</Confirm_form>
          </Yuka.Client> )

let app_token_view ~(session : Ui.session) ~id =
  match find_app session id with
  | None -> missing "/applications"
  | Some a ->
      ( "New token for " ^ a.name,
        "/applications",
        fun actions ->
          <Yuka.Client>
            <Confirm_form target=(Actions.Target.to_string (App_token id)) text="The current token stops working: update everything that pushes to this application." button="New token" danger=false user=(password_user session)>actions</Confirm_form>
          </Yuka.Client> )

let client_edit_view ~(client : M.client option) ~id =
  match client with
  | None -> missing "/clients"
  | Some c ->
      ( "Edit " ^ c.name,
        "/clients",
        fun actions ->
          <form method_=`post action=(Routes.client_update ~id ())>
            <label class_="field">"Name" <input name="name" value=c.name required=true autofocus=true /></label>
            <label class_="field">"Expire after inactivity (seconds, 0 = never)"
              <input type_=`number name="expiresAfterInactivitySeconds" min="0" value=(Int.to_string c.expires_after) />
            </label>
            (with_submit actions (submit "Save"))
          </form> )

let client_remove_view ~(session : Ui.session) ~(client : M.client option) ~id =
  match client with
  | None -> missing "/clients"
  | Some c ->
      ( "Delete " ^ c.name,
        "/clients",
        fun actions ->
          <Yuka.Client>
            <Confirm_form target=(Actions.Target.to_string (Client_delete id)) text=(if c.id = session.client.id then "This is the client of this browser: deleting it signs you out."
                 else "Apps that use its token lose access.") button="Delete" danger=true user=(password_user session)>actions</Confirm_form>
          </Yuka.Client> )

let client_elevate_view ~(session : Ui.session) ~(client : M.client option) ~id =
  match client with
  | None -> missing "/clients"
  | Some c ->
      ( "Elevate " ^ c.name,
        "/clients",
        fun actions ->
          <Yuka.Client><Elevate_form id user=(password_user session)>actions</Elevate_form></Yuka.Client> )

let client_elevate ~session ~client ~id ~alert () = dialog Page ~session ~alert (client_elevate_view ~session ~client ~id)
let client_elevate_dialog ~session ~client ~id ~alert () = dialog Overlay ~session ~alert (client_elevate_view ~session ~client ~id)

let admin_only (session : Ui.session) user = if session.user.admin then user else None

let user_edit_view ~session ~(user : M.user option) ~id =
  match admin_only session user with
  | None -> missing "/users"
  | Some u ->
      ( "Edit " ^ u.name,
        "/users",
        fun actions ->
          <Yuka.Client>
            <User_edit_form id name=u.name admin=u.admin user=(password_user session)>actions</User_edit_form>
          </Yuka.Client> )

let user_remove_view ~session ~(user : M.user option) ~id =
  match admin_only session user with
  | None -> missing "/users"
  | Some u ->
      ( "Delete " ^ u.name,
        "/users",
        fun actions ->
          <Yuka.Client>
            <Confirm_form target=(Actions.Target.to_string (User_delete id)) text="The user, their applications, clients and messages are deleted." button="Delete" danger=true user=(password_user session)>actions</Confirm_form>
          </Yuka.Client> )

let app_push_view ~(session : Ui.session) ~app =
  let back = Routes.app_messages ~app () in
  match find_app session app with
  | None -> missing back
  | Some a ->
      ( "Push message to " ^ a.name,
        back,
        fun actions ->
          <Yuka.Client>
            <Push_form app name=a.name priority=a.default_priority>actions</Push_form>
          </Yuka.Client> )

let app_push ~session ~app ~alert () = dialog Page ~session ~alert (app_push_view ~session ~app)
let app_push_dialog ~session ~app ~alert () = dialog Overlay ~session ~alert (app_push_view ~session ~app)
let app_edit ~session ~id ~alert () = dialog Page ~session ~alert (app_edit_view ~session ~id)
let app_edit_dialog ~session ~id ~alert () = dialog Overlay ~session ~alert (app_edit_view ~session ~id)
let app_remove ~session ~id ~alert () = dialog Page ~session ~alert (app_remove_view ~session ~id)
let app_remove_dialog ~session ~id ~alert () = dialog Overlay ~session ~alert (app_remove_view ~session ~id)
let app_token ~session ~id ~alert () = dialog Page ~session ~alert (app_token_view ~session ~id)
let app_token_dialog ~session ~id ~alert () = dialog Overlay ~session ~alert (app_token_view ~session ~id)
let client_edit ~session ~client ~id ~alert () = dialog Page ~session ~alert (client_edit_view ~client ~id)
let client_edit_dialog ~session ~client ~id ~alert () = dialog Overlay ~session ~alert (client_edit_view ~client ~id)
let client_remove ~session ~client ~id ~alert () = dialog Page ~session ~alert (client_remove_view ~session ~client ~id)

let client_remove_dialog ~session ~client ~id ~alert () =
  dialog Overlay ~session ~alert (client_remove_view ~session ~client ~id)

let user_edit ~session ~user ~id ~alert () = dialog Page ~session ~alert (user_edit_view ~session ~user ~id)
let user_edit_dialog ~session ~user ~id ~alert () = dialog Overlay ~session ~alert (user_edit_view ~session ~user ~id)
let user_remove ~session ~user ~id ~alert () = dialog Page ~session ~alert (user_remove_view ~session ~user ~id)
let user_remove_dialog ~session ~user ~id ~alert () = dialog Overlay ~session ~alert (user_remove_view ~session ~user ~id)

let settings ~(session : Ui.session) ~alert () =
  Yuka.Server.page ~title:"Settings - Gotify" (fun () ->
      let option value label =
        <option value selected=(session.theme = value)>(Yuka.text label)</option>
      in
      <section class_="narrow">
        <header class_="page-header"><h1>"Settings"</h1></header>
        (alert_view alert)
        <div class_="card stack">
          <h2>"Theme"</h2>
          <form method_=`post action=(Routes.theme ()) class_="row">
            <input type_=`hidden name="next" value="/settings" />
            <select name="theme" aria_label="Theme">
              (option "system" "System") (option "light" "Light") (option "dark" "Dark")
            </select>
            <button type_=`submit class_="button contained">"Apply"</button>
          </form>
        </div>
        <div class_="card stack">
          <h2>"Change password"</h2>
          <form method_=`post action=(Routes.password ()) class_="stack">
            <label class_="field">"New password"
              <input type_=`password name="pass" required=true autocomplete="new-password" />
            </label>
            (elevation_field session)
            <button type_=`submit class_="button contained">"Change password"</button>
          </form>
        </div>
        <p class_="muted">(Yuka.text ("Signed in as " ^ session.user.name))</p>
      </section>)

let elevate ~(session : Ui.session) ~next ~alert () =
  Yuka.Server.page ~title:"Confirm password - Gotify" (fun () ->
      <section class_="narrow">
        <div class_="card stack">
          <h1>"Confirm your password"</h1>
          <p>"This action needs a recent sign-in. Your session stays elevated for one hour."</p>
          (alert_view alert)
          <form method_=`post action=(Routes.elevate_post ()) class_="stack">
            <input type_=`hidden name="next" value=(Ui.safe_next next) />
            <label class_="field">(Yuka.text ("Password of " ^ session.user.name))
              <input type_=`password name="pass" required=true autofocus=true autocomplete="current-password" />
            </label>
            <button type_=`submit class_="button contained">"Confirm"</button>
          </form>
        </div>
      </section>)

(* The page of the login and register forms, with no session. *)
let public_card ~title body =
  Yuka.Server.page ~title:(title ^ " - Gotify") (fun () ->
      <div class_=(theme_class "system")>
        <header class_="appbar"><span class_="brand">"Gotify"</span></header>
        <main class_="login">body</main>
      </div>)

let login ~failed ~registered () =
  public_card ~title:"Login"
    <form method_=`post action=(Routes.login_post ()) class_="card stack login-card">
      <h1>"Login"</h1>
      (if failed = Some true then <p class_="alert" role=`alert>"Wrong username or password"</p> else Yuka.empty)
      (if registered = Some true then <p class_="notice" role=`status>"User created. You can log in now."</p> else Yuka.empty)
      <label class_="field">"Username" <input name="name" required=true autofocus=true autocomplete="username" /></label>
      <label class_="field">"Password"
        <input type_=`password name="pass" required=true autocomplete="current-password" />
      </label>
      <div class_="login-actions">
        (if !Gotify_core.Api.registration then link_button ~class_:"button outlined" (Routes.register ()) "Register"
         else Yuka.empty)
        <button type_=`submit class_="button contained">"Login"</button>
      </div>
    </form>

let register ~alert () =
  public_card ~title:"Register"
    (if not !Gotify_core.Api.registration then
       <div class_="card stack login-card">
         <h1>"Register"</h1>
         <p>"Registration is disabled on this server."</p>
         (link_button (Routes.login ()) "Back to login")
       </div>
     else
       <form method_=`post action=(Routes.register_post ()) class_="card stack login-card">
         <h1>"Register"</h1>
         (alert_view alert)
         <label class_="field">"Username" <input name="name" required=true autofocus=true autocomplete="username" /></label>
         <label class_="field">"Password"
           <input type_=`password name="pass" required=true autocomplete="new-password" />
         </label>
         <div class_="login-actions">
           (link_button (Routes.login ()) "Back to login")
           <button type_=`submit class_="button contained">"Register"</button>
         </div>
       </form>)

let not_found ~path () =
  Yuka.Server.page ~title:"Not found - Gotify" (fun () ->
      <main class_="login"><div class_="card"><h1>"Not found"</h1><p>(Yuka.text ("No page at " ^ path))</p>
      <a href="/">"Back to messages"</a></div></main>)

let error_page () =
  Yuka.Server.page ~title:"Error - Gotify" (fun () ->
      <main class_="login"><div class_="card"><h1>"Something went wrong"</h1><a href="/">"Back to messages"</a></div></main>)
